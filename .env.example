# ===============================================
# RitualRoute Server & Database Configuration
# ===============================================

# Port to run the server on (Render sets this dynamically)
PORT=3000

# Environment (development | production)
NODE_ENV=development

# -----------------------------------------------
# FIREBASE FIRESTORE CONFIGURATION
# -----------------------------------------------
# If you leave these blank, RitualRoute will automatically
# and gracefully run in "Local JSON Fallback" mode using data/db.json!
# To connect your real Firebase project:
# Option A: Provide Firebase Service Account credentials:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Option B: Path to downloaded Firebase service account JSON file:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Optional: Firebase Realtime Database URL if using Realtime DB instead of Firestore
# FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com
